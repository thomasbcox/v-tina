# Copy to .env.local and fill in. Never commit a filled-in copy:
# .gitignore ignores the whole .env* family and exempts only this example file.

# Supabase — project URL must include its scheme
NEXT_PUBLIC_SUPABASE_URL=https://REPLACE_ME.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=REPLACE_ME
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME

# Fireworks — embeddings and inference
FIREWORKS_API_KEY=REPLACE_ME
